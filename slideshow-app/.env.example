# Copy this file to `.env` in this directory and fill in your own Google
# Cloud OAuth "Desktop app" client credentials. See README.md for how to
# create them. Never commit your real `.env` file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional overrides (rarely needed):
# PYTHON_PATH=python3
# FFMPEG_PATH=
# FFPROBE_PATH=
